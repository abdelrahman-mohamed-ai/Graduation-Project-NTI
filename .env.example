# Documentation only: export these variables in your shell or hosting dashboard.
# Never commit a real key. Generate a long random SECRET_KEY for production.
EDUGUARD_ENV=development
SECRET_KEY=
# Local defaults continue to use instance/eduguard.db.
# Production: absolute path on a persistent disk, e.g. /var/data/eduguard.db
EDUGUARD_DATABASE_PATH=
EDUGUARD_SEED_DATABASE=true
PORT=8000
# DATABASE_URL is intentionally not supported yet. No automatic migration occurs.
